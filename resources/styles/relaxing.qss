/* Relaxing theme, generated by AI GPT-5.6 */


QWidget {
    background-color: #18201F;
    color: #D7DEDB;
}

/* ---------------------------------------------------------
   Labels
   --------------------------------------------------------- */

QLabel {
    color: #DCE3E0;
}


/* ---------------------------------------------------------
   Buttons
   --------------------------------------------------------- */

QPushButton {
    background-color: #293533;
    color: #DCE3E0;
    border: 1px solid #3B4946;
    border-radius: 5px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #334541;
    border: 1px solid #52635E;
}

QPushButton:pressed {
    background-color: #25312F;
}

QPushButton:disabled {
    background-color: #202826;
    color: #68736F;
    border: 1px solid #2D3634;
}


/* ---------------------------------------------------------
   Text Entry Fields
   --------------------------------------------------------- */

QLineEdit,
QTextEdit {
    background-color: #202A28;
    color: #DCE3E0;
    border: 1px solid #3A4945;
    border-radius: 5px;
    selection-background-color: #46635B;
    selection-color: #F0F4F2;
}

/* Placeholder text */
QLineEdit::placeholder {
  color: #949494;
}

QLineEdit:focus,
QTextEdit:focus {
    border: 1px solid #59766D;
}

QLineEdit:disabled,
QTextEdit:disabled {
    background-color: #1D2523;
    color: #68736F;
    border: 1px solid #303A37;
}


/* ---------------------------------------------------------
   Combo Box
   --------------------------------------------------------- */

QComboBox {
    background-color: #202A28;
    color: #DCE3E0;
    border: 1px solid #3A4945;
    border-radius: 5px;
    padding: 5px 8px;
}

QComboBox:hover {
    border: 1px solid #52635E;
}

QComboBox:focus {
    border: 1px solid #59766D;
}

QComboBox QAbstractItemView {
    background-color: #202A28;
    color: #DCE3E0;
    selection-background-color: #3B514B;
    selection-color: #F0F4F2;
    border: 1px solid #3A4945;
}


/* ---------------------------------------------------------
   Radio Buttons
   --------------------------------------------------------- */

QRadioButton {
    color: #DCE3E0;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: #222C2A;
    border: 1px solid #52605C;
}

QRadioButton::indicator:hover {
    background-color: #2C3936;
    border: 1px solid #697A74;
}

QRadioButton::indicator:checked {
    background-color: #6B8980;
    border: 1px solid #7D9991;
}

QRadioButton::indicator:disabled {
    background-color: #202725;
    border: 1px solid #3A4542;
}


/* ---------------------------------------------------------
   Scroll Bars
   --------------------------------------------------------- */

QScrollBar:vertical {
    background-color: #18201F;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #394743;
    border-radius: 5px;
    min-height: 25px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4B5D57;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #18201F;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #394743;
    border-radius: 5px;
    min-width: 25px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4B5D57;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}


/* ---------------------------------------------------------
   Tooltips
   --------------------------------------------------------- */

QToolTip {
    background-color: #26322F;
    color: #DCE3E0;
    border: 1px solid #4A5B56;
    padding: 5px;
}
```
